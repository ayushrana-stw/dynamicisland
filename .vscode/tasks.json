{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/DynamicIsland.sln", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch (hot reload)",
      "type": "process",
      "command": "dotnet",
      "args": ["watch", "--project", "${workspaceFolder}/src/DynamicIsland.App", "--", "--demo"],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "register package (enables notifications)",
      "type": "process",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/register-package.ps1"],
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "run on Android (phone or emulator)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/DynamicIsland.Android", "-t:Run", "/property:GenerateFullPaths=true"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish (Android APK)",
      "type": "process",
      "command": "dotnet",
      "args": ["publish", "${workspaceFolder}/src/DynamicIsland.Android", "-c", "Release"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish (Windows, trimmed single file)",
      "type": "process",
      "command": "dotnet",
      "args": ["publish", "${workspaceFolder}/src/DynamicIsland.App", "-c", "Release", "-r", "win-x64", "--self-contained", "-p:PublishSingleFile=true", "-p:PublishTrimmed=true", "-p:IncludeNativeLibrariesForSelfExtract=true","-o", "${workspaceFolder}/publish/win-x64"],
      "problemMatcher": "$msCompile"
    }
  ]
}
