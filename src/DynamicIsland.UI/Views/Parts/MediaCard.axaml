<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DynamicIsland.UI.ViewModels"
             xmlns:c="using:DynamicIsland.UI.Controls"
             x:Class="DynamicIsland.UI.Views.Parts.MediaCard"
             x:DataType="vm:IslandViewModel"
             Width="372" Height="{Binding ExpandedMediaHeight}"
             HorizontalAlignment="Center" VerticalAlignment="Top">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Artwork · title/artist · visualizer -->
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="22,20,24,0">
      <Border x:Name="Art" Classes="art pop d1" Classes.paused="{Binding IsPaused}"
              Width="60" Height="60" CornerRadius="15">
        <Panel>
          <PathIcon Data="{StaticResource IconMusic}" Width="24" Height="24"
                    Foreground="{StaticResource IslandSecondaryText}" IsVisible="{Binding !HasArtwork}" />
          <TransitioningContentControl Classes="artfade" Content="{Binding Artwork}" />
        </Panel>
      </Border>

      <StackPanel Grid.Column="1" Classes="pop d2" VerticalAlignment="Center" Margin="14,0,12,0" Spacing="2">
        <TransitioningContentControl Classes="track" Content="{Binding MediaTitle}">
          <TransitioningContentControl.ContentTemplate>
            <DataTemplate x:DataType="x:String">
              <c:MarqueeText Text="{Binding}" FontFamily="{StaticResource IslandFont}" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource IslandPrimaryText}"
                             IsActive="{Binding $parent[UserControl].((vm:IslandViewModel)DataContext).AnimateMarquee}" />
            </DataTemplate>
          </TransitioningContentControl.ContentTemplate>
        </TransitioningContentControl>
        <TransitioningContentControl Classes="track" Content="{Binding MediaArtist}"
                                     IsVisible="{Binding MediaArtist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TransitioningContentControl.ContentTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="subtitle" Text="{Binding}" />
            </DataTemplate>
          </TransitioningContentControl.ContentTemplate>
        </TransitioningContentControl>
      </StackPanel>

      <StackPanel Grid.Column="2" Classes="pop d2" Orientation="Horizontal" Spacing="2.5" VerticalAlignment="Center"
                  Classes.playing="{Binding AnimateExpandedVisualizer}">
        <Rectangle Classes="bar b1" Fill="{Binding AccentBrush}" />
        <Rectangle Classes="bar b2" Fill="{Binding AccentBrush}" />
        <Rectangle Classes="bar b3" Fill="{Binding AccentBrush}" />
        <Rectangle Classes="bar b4" Fill="{Binding AccentBrush}" />
      </StackPanel>
    </Grid>

    <!-- Progress: elapsed · (drag to seek) · remaining -->
    <Grid Grid.Row="1" Classes="pop d3" ColumnDefinitions="*,Auto,*" Margin="22,14,22,0" IsVisible="{Binding HasTimeline}">
      <TextBlock Classes="time" Text="{Binding ElapsedText}" HorizontalAlignment="Left" />
      <Panel x:Name="SeekArea" Grid.Column="1" Classes="seek"
             Classes.enabled="{Binding CanSeek}" Classes.scrubbing="{Binding IsScrubbing}"
             Width="{x:Static vm:IslandViewModel.ProgressTrackWidth}">
        <Border Classes="track">
          <Border Classes="fill" Classes.smooth="{Binding ProgressSmooth}"
                  Width="{Binding ProgressWidth}" Background="{Binding AccentBrush}" />
        </Border>
      </Panel>
      <TextBlock Grid.Column="2" Classes="time" Text="{Binding RemainingText}" HorizontalAlignment="Right" />
    </Grid>

    <!-- App · controls · shortcuts -->
    <Grid Grid.Row="2" Classes="pop d4" ColumnDefinitions="*,Auto,*" Margin="24,0,14,8" VerticalAlignment="Center">
      <TextBlock Classes="caption" Text="{Binding MediaApp}" VerticalAlignment="Center" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <Button Classes="icon" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous" AutomationProperties.Name="Previous track">
          <PathIcon Data="{StaticResource IconPrevious}" />
        </Button>
        <Button Classes="icon large" Command="{Binding PlayPauseCommand}" AutomationProperties.Name="Play or pause">
          <Panel>
            <PathIcon Classes="swap" Classes.on="{Binding IsPlaying}" Data="{StaticResource IconPause}" />
            <PathIcon Classes="swap" Classes.on="{Binding IsPaused}" Data="{StaticResource IconPlay}" />
          </Panel>
        </Button>
        <Button Classes="icon" Command="{Binding NextCommand}" ToolTip.Tip="Next" AutomationProperties.Name="Next track">
          <PathIcon Data="{StaticResource IconNext}" />
        </Button>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Classes="icon small" Command="{Binding OpenTimerPickerCommand}"
                ToolTip.Tip="Timer" AutomationProperties.Name="Timer">
          <PathIcon Data="{StaticResource IconTimer}" />
        </Button>
        <Panel>
          <Button Classes="icon small" Command="{Binding OpenHistoryCommand}"
                  ToolTip.Tip="Notifications" AutomationProperties.Name="Notification history">
            <PathIcon Data="{StaticResource IconBell}" />
          </Button>
          <Border Classes="badge" Margin="0,-2,-3,0" IsVisible="{Binding HasHistory}">
            <TextBlock Text="{Binding HistoryCountText}" />
          </Border>
        </Panel>
        <Button Classes="icon small" Command="{Binding OpenSettingsCommand}"
                ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
          <PathIcon Data="{StaticResource IconSettings}" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
