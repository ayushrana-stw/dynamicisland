<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DynamicIsland.UI.ViewModels"
             x:Class="DynamicIsland.UI.Views.Parts.HistoryCard"
             x:DataType="vm:IslandViewModel"
             Width="372" HorizontalAlignment="Center" VerticalAlignment="Top">

  <Grid RowDefinitions="Auto,Auto" Margin="12,14,12,10">

    <!-- Header -->
    <Grid Classes="pop d1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
      <Button Classes="icon small" Command="{Binding BackCommand}" ToolTip.Tip="Back" AutomationProperties.Name="Back">
        <PathIcon Data="{StaticResource IconBack}" />
      </Button>
      <TextBlock Grid.Column="1" Classes="title" Text="Notifications" Margin="6,0,0,0" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="chip small" Content="Clear all" Margin="0,0,6,0"
              Command="{Binding ClearHistoryCommand}" IsVisible="{Binding HasHistory}" />
    </Grid>

    <!-- Empty state -->
    <StackPanel Grid.Row="1" Classes="pop d2" Spacing="6" Margin="0,10,0,0" HorizontalAlignment="Center"
                IsVisible="{Binding !HasHistory}">
      <PathIcon Data="{StaticResource IconBell}" Width="22" Height="22" Foreground="{StaticResource IslandTertiaryText}" />
      <TextBlock Classes="caption" FontSize="12" Text="You're all caught up" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- List -->
    <ScrollViewer Grid.Row="1" Classes="pop d2" MaxHeight="224" IsVisible="{Binding HasHistory}"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding History}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryItem">
            <Button Classes="row" Height="56"
                    Command="{Binding $parent[UserControl].((vm:IslandViewModel)DataContext).OpenHistoryItemCommand}"
                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="34" Height="34" CornerRadius="9" Background="#1F1F22" ClipToBounds="True" VerticalAlignment="Center">
                  <Panel>
                    <PathIcon Data="{StaticResource IconBell}" Width="15" Height="15"
                              Foreground="{StaticResource IslandSecondaryText}" IsVisible="{Binding !HasIcon}" />
                    <Image Source="{Binding Icon}" Margin="3" IsVisible="{Binding HasIcon}" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" Spacing="1">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Classes="caption" Text="{Binding AppName}" />
                    <TextBlock Classes="caption" Text="·" />
                    <TextBlock Classes="caption" Text="{Binding TimeText}" />
                  </StackPanel>
                  <TextBlock Classes="title" FontSize="13" Text="{Binding Title}" />
                </StackPanel>
                <Button Grid.Column="2" Classes="icon small" VerticalAlignment="Center"
                        Command="{Binding $parent[UserControl].((vm:IslandViewModel)DataContext).RemoveHistoryItemCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss">
                  <PathIcon Data="{StaticResource IconClose}" />
                </Button>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
