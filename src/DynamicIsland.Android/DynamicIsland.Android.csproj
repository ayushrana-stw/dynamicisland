<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Android app: the island floats over other apps as a system overlay, hosted by a foreground service.
    Shares the island and settings UI with the desktop app through DynamicIsland.UI.
    Not in DynamicIsland.sln, so the desktop build keeps working on machines without the Android workload.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Avalonia 12's Android support needs .NET 10; the shared libraries stay on .NET 9. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Android 8.0: the first version with TYPE_APPLICATION_OVERLAY windows. -->
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <!-- "Android" would clash with the Android.* namespaces of the platform bindings. -->
    <RootNamespace>DynamicIsland.Droid</RootNamespace>
    <AssemblyName>DynamicIsland.Android</AssemblyName>
    <ApplicationId>com.dynamicisland.app</ApplicationId>
    <ApplicationTitle>Dynamic Island</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    Android Studio's default SDK folder, and the JDK that `scripts/setup-android.ps1` installs next to it.
    Override with -p:AndroidSdkDirectory=... / -p:JavaSdkDirectory=... or ANDROID_HOME / JAVA_HOME.
  -->
  <PropertyGroup>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and '$(ANDROID_HOME)' == '' and Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and '$(JAVA_HOME)' == '' and Exists('$(LOCALAPPDATA)\Android\jdk')">$(LOCALAPPDATA)\Android\jdk</JavaSdkDirectory>
  </PropertyGroup>

  <!-- Release: one APK that installs on any phone (sideloading, no store). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- The Android SDK's implicit usings clash with Avalonia names (Application, Button...); import explicitly. -->
  <ItemGroup>
    <Using Remove="Android.App" />
    <Using Remove="Android.Widget" />
    <Using Remove="Android.OS.Bundle" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicIsland.Core\DynamicIsland.Core.csproj" />
    <ProjectReference Include="..\DynamicIsland.UI\DynamicIsland.UI.csproj" />
  </ItemGroup>
</Project>
