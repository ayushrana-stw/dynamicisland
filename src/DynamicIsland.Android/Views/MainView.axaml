<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:DynamicIsland.UI.Views"
             xmlns:local="using:DynamicIsland.Droid.Views"
             x:Class="DynamicIsland.Droid.Views.MainView"
             Background="#101012">
  <!-- Avalonia already keeps the content clear of the status and navigation bars. -->
  <views:SettingsView x:Name="Settings" Padding="0,20,0,0">
    <views:SettingsView.TopContent>
      <local:PermissionsPanel x:Name="Permissions" />
    </views:SettingsView.TopContent>
  </views:SettingsView>
</UserControl>
