<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DynamicIsland.App.ViewModels"
             x:Class="DynamicIsland.App.Views.Parts.IdleCard"
             x:DataType="vm:IslandViewModel"
             Width="340" Height="118" HorizontalAlignment="Center" VerticalAlignment="Top">

  <Grid RowDefinitions="Auto,*" Margin="20,14,20,14">

    <!-- Clock and date (or who is using the mic/camera) -->
    <Grid ColumnDefinitions="Auto,*">
      <TextBlock Classes="clock pop d1" Text="{Binding ClockText}" VerticalAlignment="Center" Margin="4,0,14,0" />
      <StackPanel Grid.Column="1" Classes="pop d2" VerticalAlignment="Center" Spacing="1">
        <TextBlock Classes="subtitle" Text="{Binding DateText}" Foreground="{StaticResource IslandPrimaryText}" />
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowPrivacy}">
          <Ellipse Classes="privacy" Fill="{Binding PrivacyBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="caption" Text="{Binding PrivacyText}" Foreground="{Binding PrivacyBrush}" />
        </StackPanel>
        <TextBlock Classes="caption" Text="Nothing playing" IsVisible="{Binding !ShowPrivacy}" />
      </StackPanel>
    </Grid>

    <!-- Quick actions -->
    <UniformGrid Grid.Row="1" Classes="pop d3" Columns="4" VerticalAlignment="Bottom">
      <Button Classes="chip" Margin="0,0,4,0" Command="{Binding OpenTimerPickerCommand}" AutomationProperties.Name="Timer">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <PathIcon Data="{StaticResource IconTimer}" />
          <TextBlock Text="Timer" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="chip" Margin="2,0" Command="{Binding StartStopwatchCommand}" AutomationProperties.Name="Stopwatch">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <PathIcon Data="{StaticResource IconStopwatch}" />
          <TextBlock Text="Watch" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Panel Margin="2,0">
        <Button Classes="chip" HorizontalAlignment="Stretch" Command="{Binding OpenHistoryCommand}" AutomationProperties.Name="Notification history">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Data="{StaticResource IconBell}" />
            <TextBlock Text="Alerts" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Border Classes="badge" Margin="0,-4,-2,0" IsVisible="{Binding HasHistory}">
          <TextBlock Text="{Binding HistoryCountText}" />
        </Border>
      </Panel>
      <Button Classes="chip" Margin="4,0,0,0" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Settings">
        <PathIcon Data="{StaticResource IconSettings}" />
      </Button>
    </UniformGrid>
  </Grid>
</UserControl>
