<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DynamicIsland.App.ViewModels"
        xmlns:img="using:Avalonia.Media.Imaging"
        xmlns:parts="using:DynamicIsland.App.Views.Parts"
        x:Class="DynamicIsland.App.Views.IslandWindow"
        x:DataType="vm:IslandViewModel"
        Title="Dynamic Island"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">

  <Window.DataTemplates>
    <DataTemplate x:DataType="img:Bitmap">
      <Image Source="{Binding}" Stretch="UniformToFill" />
    </DataTemplate>
  </Window.DataTemplates>

  <Panel>
    <!-- ===== The island ===== -->
    <Border x:Name="Island"
            Classes="island"
            Classes.expanded="{Binding IsExpanded}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,4,0,0"
            Width="{Binding IslandWidth}"
            Height="{Binding IslandHeight}"
            CornerRadius="{Binding IslandCornerRadius}"
            AutomationProperties.Name="Dynamic Island">
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" />
          <MenuItem Header="Notifications" Command="{Binding OpenHistoryCommand}" />
          <MenuItem Header="Timer" Command="{Binding OpenTimerPickerCommand}" />
          <Separator />
          <MenuItem Header="Hide island" Command="{Binding HideIslandCommand}" />
          <MenuItem Header="Exit" Command="{Binding ExitAppCommand}" />
        </ContextMenu>
      </Border.ContextMenu>
      <Panel>
        <!-- Ambient colour from the album art, breathing slowly while music plays. -->
        <Border Classes="glow" Classes.on="{Binding ShowAmbientGlow}" Background="{Binding GlowBrush}" />

        <parts:CompactViews />
        <parts:IdleCard Classes="fade delayed" Classes.shown="{Binding ShowExpandedIdle}" />
        <parts:MediaCard Classes="fade delayed" Classes.shown="{Binding ShowExpandedMedia}" />
        <parts:NotificationCard Classes="fade delayed" Classes.shown="{Binding ShowExpandedNotification}" />
        <parts:HistoryCard Classes="fade delayed" Classes.shown="{Binding ShowExpandedHistory}" />
        <parts:TimerPickerCard Classes="fade delayed" Classes.shown="{Binding ShowExpandedTimerPicker}" />
        <parts:TimerCard Classes="fade delayed" Classes.shown="{Binding ShowExpandedTimer}" />
      </Panel>
    </Border>

    <!-- ===== Split island: a bubble for a second activity (timer or mic/camera) ===== -->
    <Border x:Name="Bubble" Classes="bubble" Classes.shown="{Binding ShowBubble}" Margin="{Binding BubbleMargin}"
            ToolTip.Tip="{Binding PrivacyText}">
      <Panel>
        <!-- Timer: remaining time as a shrinking ring -->
        <Panel IsVisible="{Binding BubbleShowsTimer}">
          <Arc Width="26" Height="26" StartAngle="-90" SweepAngle="{Binding TimerSweep}"
               Stroke="#FFFF9F0A" StrokeThickness="2.5" StrokeLineCap="Round" />
          <TextBlock Text="{Binding TimerShortText}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFF9F0A"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
        <!-- Microphone / camera in use -->
        <Panel IsVisible="{Binding BubbleShowsPrivacy}">
          <PathIcon Data="{StaticResource IconMic}" Width="15" Height="15" Foreground="{Binding PrivacyBrush}"
                    IsVisible="{Binding !PrivacyUsesCamera}" />
          <PathIcon Data="{StaticResource IconCamera}" Width="15" Height="15" Foreground="{Binding PrivacyBrush}"
                    IsVisible="{Binding PrivacyUsesCamera}" />
        </Panel>
      </Panel>
    </Border>
  </Panel>
</Window>
