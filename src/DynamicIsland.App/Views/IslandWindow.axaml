<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DynamicIsland.UI.ViewModels"
        xmlns:views="using:DynamicIsland.UI.Views"
        x:Class="DynamicIsland.App.Views.IslandWindow"
        x:DataType="vm:IslandViewModel"
        Title="Dynamic Island"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">

  <views:IslandView x:Name="IslandView" />
</Window>
