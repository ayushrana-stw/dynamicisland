<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DynamicIsland.UI.Views"
        x:Class="DynamicIsland.App.Views.SettingsWindow"
        Title="Dynamic Island Settings"
        Width="520" Height="720" MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        Background="#D8101012"
        ExtendClientAreaToDecorationsHint="True">

  <!-- The header sits in the extended title-bar area. -->
  <views:SettingsView Padding="0,44,0,0" />
</Window>
